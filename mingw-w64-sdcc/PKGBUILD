# Maintainer: Joel Holdsworth <jholdsworth@nvidia.com>

_realname=sdcc
pkgbase=mingw-w64-${_realname}
pkgname="${MINGW_PACKAGE_PREFIX}-${_realname}"
pkgver=4.5.0
pkgrel=1
pkgdesc="Retargettable ANSI C compiler (mingw-w64)"
arch=('any')
mingw_arch=('mingw64')
url="https://sdcc.sourceforge.net/"
license=("GPL")
options=('!strip' '!ccache')
depends=("${MINGW_PACKAGE_PREFIX}-gputils")
makedepends=("bison"
             "flex"
             "patch"
             "${MINGW_PACKAGE_PREFIX}-boost")
source=("$_realname-$pkgver.tar.bz2::https://sourceforge.net/projects/sdcc/files/sdcc/$pkgver/$_realname-src-$pkgver.tar.bz2"
        "0001-Build-all-mcs51-models.patch"
        "0002-ucsim-Rename-B-define-to-SPR_B.patch"
        "0003-Add-support-cpp-gcc-to-PATH-in-sdcc-script.patch"
        "0004-Added-missing-include-of-string.h.patch")
sha256sums=("d5030437fb436bb1d93a8dbdbfb46baaa60613318f4fb3f5871d72815d1eed80"
            "954ef485365d5fe34e509534cff3930eebe7abd5a5ab1d117d5d9f74063b0dd6"
            "eda561060b23382d88787d917c3fc6b00043738cd1abef3098431e0d231fa08a"
            "33d356d3716245d47b57be8694b08ab744cdf82e77f9b2bc74a3be9671c88d90"
            "fa2e14262a1cc755a6b5cb649ebc9aa59a93d3c91c5b405f7a794f3437a0be48")

prepare() {
  cd "${srcdir}/${_realname}-${pkgver}"
  for p in \
    "0001-Build-all-mcs51-models.patch" \
    "0002-ucsim-Rename-B-define-to-SPR_B.patch" \
    "0003-Add-support-cpp-gcc-to-PATH-in-sdcc-script.patch" \
    "0004-Added-missing-include-of-string.h.patch"; do \
    patch -p1 -i "$srcdir/$p"
  done
}

build() {
  mkdir "${srcdir}/build-${MSYSTEM}" && cd "${srcdir}/build-${MSYSTEM}"

  # Avoid C23 problems:
  #   - "typedef short bool;" fails because "bool" is a reserved work on C23.
  CFLAGS+=" -std=gnu17"

  "${srcdir}/${_realname}-${pkgver}/configure" \
    --prefix=${MINGW_PREFIX} \
    --includedir=${MINGW_PREFIX}/include/sdcc \
    --disable-werror

  # Replace gpasm path with a Windows path (with the file extension removed).
  # This is necessary because the otherwise the native sdcc executable is given
  # a UNIX path to gpasm in the --asm argument by the Makefile.
  local gpasm=$(cygpath -m ${MINGW_PREFIX}/bin/gpasm)
  find device -name Makefile | \
    xargs sed -i "s#\(CCAS\) = '.*gpasm'#\1 = ${gpasm%.*}#"

  # Force single threaded make, because multi-threaded build is unreliable
  # e.g. in the device/lib/mcs51 directory.
  make -j1
}

package() {
  make -C "${srcdir}/build-${MSYSTEM}" DESTDIR="$pkgdir" install

  cd "$pkgdir/${MINGW_PREFIX}"

  # Remove spurious binutils that will conflict with other packages.
  rm \
    bin/dlltool.exe \
    bin/dllwrap.exe \
    bin/windmc.exe \
    bin/windres.exe
}
